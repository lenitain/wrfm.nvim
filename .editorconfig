# EditorConfig — https://editorconfig.org
# Indentation follows the Neovim-Lua plugin community convention (2 spaces),
# mirroring the settings in stylua.toml so editors and StyLua agree.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
